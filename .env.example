# Get your Read Access Token at https://www.themoviedb.org → Account Settings → API
# Use the "API Read Access Token (v4 auth)" — the long JWT starting with eyJ...
VITE_TMDB_READ_TOKEN=your_read_access_token_here

# Get a free key at https://www.omdbapi.com/apikey.aspx (instant, no credit card)
VITE_OMDB_API_KEY=your_omdb_key_here

# Supabase project → Settings → Data API (Project URL) and Settings → API
# Keys (the "anon" / "public" key — never the "service_role" / "secret" one).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
